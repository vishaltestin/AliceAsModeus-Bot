# MySQL / MariaDB connection string
DATABASE_URL="mysql://user:password@localhost:3306/wacrm"

# Auth.js v5 secret. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"

# Public URL used in media links and invitation links
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# AES-256-GCM key for encrypted WhatsApp access tokens.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY="replace-with-output-of-openssl-rand-hex-32"

# Optional: absolute upload directory for production deployments.
# Defaults to ./uploads in development.
# UPLOAD_DIR="/var/www/wacrm-uploads"

# Optional: full path to ffmpeg when it is not available on PATH.
# FFMPEG_PATH="/usr/bin/ffmpeg"

# Legacy global Meta webhook app secret. This is OPTIONAL now — each company
# stores its OWN Meta Developer App Secret (encrypted) in Settings → WhatsApp,
# and the shared webhook endpoint verifies per company. Keep this only as a
# fallback for existing single-app deployments.
# META_APP_SECRET="replace-with-meta-app-secret"

# Protects GET /api/automations/cron when set.
# AUTOMATION_CRON_SECRET="replace-with-cron-secret"

# Set to true only for local template UI testing without Meta.
WHATSAPP_TEMPLATES_DRY_RUN="false"

# Platform Admin (SaaS super admin). Create with: npm run db:seed
# Every new account starts on the FREE plan with a lifetime quota of 10
# messages; the Platform Admin (Settings → /platform-admin) sets custom quotas.
PLATFORM_ADMIN_EMAIL="admin@your-platform.com"
PLATFORM_ADMIN_PASSWORD="replace-with-a-strong-password"
# PLATFORM_ADMIN_NAME="Platform Admin"

# Optional email delivery for password-reset links. Resend is used when configured.
# RESEND_API_KEY="re_..."
# RESEND_FROM_EMAIL="wacrm <no-reply@example.com>"
