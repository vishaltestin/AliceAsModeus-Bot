# Copy this file to `.env` and fill in your real values.

# ---- Reddit API credentials ----
# Create a "script" app at: https://www.reddit.com/prefs/apps
# (see README.md for step-by-step instructions)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=

# A short, unique description of your bot (required by Reddit's rules).
# Format: <platform>:<app id>:<version> (by /u/<your username>)
REDDIT_USER_AGENT=AliceAsModeusBot/1.0 (by /u/your_username)

# ---- Discord (for discord_bot.py) ----
# Create an app at https://discord.com/developers/applications and copy the
# bot token. No approval or payment needed. See discord_bot.py header.
DISCORD_TOKEN=

# ---- OpenAI (optional) ----
# Used for in-character replies. If left empty, the bot falls back to
# random lines from personality/quotes.txt and personality/facts.txt.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
